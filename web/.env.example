# Minted — web config. All NEXT_PUBLIC_* values are exposed to the browser (safe, public).
# Copy to .env.local and fill NEXT_PUBLIC_FACTORY_ADDRESS after deploying the Factory.

NEXT_PUBLIC_CHAIN_ID=84532

# Set this to the Factory address printed by:
#   forge script script/DeployFactory.s.sol:DeployFactory --rpc-url https://sepolia.base.org --broadcast
NEXT_PUBLIC_FACTORY_ADDRESS=

# Verified Base Sepolia test USDC (the token Aave's market accepts). Usually leave as-is.
NEXT_PUBLIC_USDC_ADDRESS=0xba50Cd2A20f6DA35D788639E581bca8d0B5d4D5f

NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
